# Copy to .env and fill in. Never commit .env.

# Legacy Laravel database (shared with the old site and the new frontend).
# The schema belongs to Laravel migrations: never run drizzle-kit push/migrate against it.
# Local docker DB: prefer a copy (e.g. dad_db_admin) so admin experiments don't touch dad_db.
DATABASE_URL="mysql://root:rootpassword@localhost:3306/dad_db_admin"

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public website, for the "Back to the site" link.
PUBLIC_FRONTEND_URL=https://app.domingoasdez.com

# --- Media display (same keys as domingoasdez-app) ---
# Legacy origin: serves /images/... and /storage/... (redirects to R2 when the file is not on disk).
MEDIA_BASE_URL=http://localhost:8000
# true builds /storage/... URLs from the R2 public domain directly.
MEDIA_CDN_ENABLED=false
# Public domain of R2_BUCKET. Development: https://dev-cdn.domingoasdez.com
MEDIA_CDN_BASE_URL=https://cdn.domingoasdez.com

# --- Cloudflare R2 uploads (same keys/values as the Laravel .env, UPLOADS_DISK=r2) ---
# Object keys mirror the DB paths: /storage/media/images/x.jpg -> storage/media/images/x.jpg
# Development uses the test bucket `domingoasdez-dev` (copy the R2_* values from the legacy
# site's local .env); never point a development setup at the production bucket.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# --- Production (VPS / PM2, adapter-node). Vite ignores these in `npm run dev`. ---
# HOST=127.0.0.1
# PORT=3004
# ORIGIN=https://admin.domingoasdez.com
# Trust nginx for HTTPS and Cloudflare for the visitor IP (used by audit logs and login throttling).
# PROTOCOL_HEADER=x-forwarded-proto
# ADDRESS_HEADER=CF-Connecting-IP
# BODY_SIZE_LIMIT=25M
