# Copy to .env and fill in. Never commit .env.

# Database shared with the legacy site and the new frontend. This app owns its schema
# (drizzle/migrations, `npm run db:migrate`); never run `drizzle-kit push`.
# Locally the legacy site, the public app and the admin all use dad_db (a production dump).
DATABASE_URL="mysql://root:rootpassword@localhost:3306/dad_db"
# Production: a user with DDL rights, used only by `npm run db:migrate` / `db:baseline`, so the
# runtime DATABASE_URL user can stay limited to SELECT/INSERT/UPDATE/DELETE. Falls back to
# DATABASE_URL when unset.
# MIGRATION_DATABASE_URL="mysql://dad_migrations:...@localhost:3306/dad_db"

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public website (domingoasdez-app), for the "Back to the site" link and the links in the
# worker's emails. app.domingoasdez.com only redirects here now.
PUBLIC_FRONTEND_URL=https://domingoasdez.com

# --- Media display (same keys as domingoasdez-app) ---
# Legacy origin: serves /images/... and /storage/... (redirects to R2 when the file is not on disk).
MEDIA_BASE_URL=http://localhost:8000
# true builds /storage/... URLs from the R2 public domain directly.
MEDIA_CDN_ENABLED=false
# Public domain of R2_BUCKET. Development: https://dev-cdn.domingoasdez.com
MEDIA_CDN_BASE_URL=https://cdn.domingoasdez.com

# --- Cloudflare R2 uploads (same keys/values as the Laravel .env, UPLOADS_DISK=r2) ---
# Object keys mirror the DB paths: /storage/media/images/x.jpg -> storage/media/images/x.jpg
# Development uses the test bucket `domingoasdez-dev` (copy the R2_* values from the legacy
# site's local .env); never point a development setup at the production bucket.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto

# --- Background jobs worker (docs/jobs.md, `npm run worker -- list`) ---
# Jobs to schedule: comma-separated names, or "all" (every ported job). Empty: none. Locally the
# legacy jobs already run on the shared dad_db: enable a job here only to test it.
WORKER_JOBS=
# true (default): mail and social media posts are logged, not sent. Production: false.
WORKER_DRY_RUN=true
# debug | info | warn | error
WORKER_LOG_LEVEL=info
# Worker emails (flash interviews, score report bans, account deletion): the site's own SMTP
# server, same keys and values as domingoasdez-app. Not needed while WORKER_DRY_RUN=true.
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# ssl (implicit TLS, also port 465) | tls (STARTTLS required) | empty
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=geral@domingoasdez.com
MAIL_FROM_NAME="Domingo às Dez"
# Facebook page and Instagram account the worker publishes to (same values as the legacy .env).
# Only publish-social-media uses them, and only with WORKER_DRY_RUN=false.
# FB_GRAPH_URL: leave as it is in production; locally, point it at a fake Graph API (with fake
# tokens) to test publishing without posting (docs/jobs.md, "publish-social-media").
FB_GRAPH_URL=https://graph.facebook.com
FB_GRAPH_VERSION=v24.0
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_SYSTEM_USER_TOKEN=
IG_USER_ID=
# true: score-report-consumer only logs the scores it would set ("would update …"), to compare
# with the legacy job on a match day before the cutover.
SCORE_REPORT_CONSUMER_SHADOW=false

# --- Production (VPS / PM2, adapter-node). Vite ignores these in `npm run dev`. ---
# HOST=127.0.0.1
# PORT=3004
# ORIGIN=https://admin.domingoasdez.com
# Trust nginx for HTTPS and Cloudflare for the visitor IP (used by audit logs and login throttling).
# PROTOCOL_HEADER=x-forwarded-proto
# ADDRESS_HEADER=CF-Connecting-IP
# BODY_SIZE_LIMIT=25M
